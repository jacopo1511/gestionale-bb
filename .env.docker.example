# Copia in .env.docker e compila. NON committare .env.docker.

# ─── Database (container Postgres) ───────────────────────────
POSTGRES_USER=gestionale
POSTGRES_PASSWORD=metti-una-password-lunga
POSTGRES_DB=gestionale
# Percorso sull'host Unraid dove salvare i dati del DB
DB_DATA_DIR=/mnt/user/appdata/gestionale/db

# ─── App ────────────────────────────────────────────────────
# Immagine compilata da GitHub (solo per docker-compose.unraid.yml).
# Sostituisci <tuo-utente> con il tuo nome utente GitHub.
APP_IMAGE=ghcr.io/<tuo-utente>/gestionale-bb:latest

# Genera: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
APP_SECRET=48-byte-casuali-in-base64
APP_BASE_URL=https://gestionale.amaresirolo.com
APP_PORT=3000
# Percorso sull'host Unraid per le immagini dei documenti (cifrate)
DOCUMENTS_DIR=/mnt/user/appdata/gestionale/documenti

# Amministratore iniziale (usato una tantum da: docker compose run --rm app node scripts/create-admin.mjs)
ADMIN_EMAIL=jacopomcs@gmail.com
ADMIN_PASSWORD=scegli-una-password-robusta

# ─── Cloudflare Tunnel ──────────────────────────────────────
# Token del tunnel creato in Cloudflare Zero Trust → Networks → Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
