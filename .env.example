# ─────────────────────────────────────────────────────────────
# Database PostgreSQL
# ─────────────────────────────────────────────────────────────
# Opzione A — Neon (gestito, gratis, regione EU Francoforte): https://neon.tech
#   Crea un progetto, copia la "connection string" e incollala qui.
# Opzione B — Postgres in container su Unraid:
#   DATABASE_URL="postgresql://gestionale:PASSWORD@IP_UNRAID:5432/gestionale?schema=public"
DATABASE_URL="postgresql://user:password@localhost:5432/gestionale?schema=public"

# ─────────────────────────────────────────────────────────────
# Segreto applicativo — DEVE essere lungo e casuale.
# Genera con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Da questo si derivano: chiave di sessione, chiave di cifratura credenziali/documenti,
# segreto dei link di check-in.
# ─────────────────────────────────────────────────────────────
APP_SECRET="cambia-questo-con-48-byte-casuali-in-base64"

# URL pubblico dell'app (usato nei link inviati agli ospiti)
APP_BASE_URL="http://localhost:3000"

# Cartella dove vengono salvate le immagini dei documenti (cifrate).
# In produzione su Unraid puntare a una share dedicata, es. /mnt/user/gestionale/documenti
DOCUMENTS_DIR="./.data/documenti"

# ─────────────────────────────────────────────────────────────
# Utente amministratore creato dal seed (npm run db:seed)
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="jacopomcs@gmail.com"
ADMIN_PASSWORD="scegli-una-password-robusta"
